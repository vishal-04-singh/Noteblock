PORT=4000
FRONTEND_URL=http://localhost:5173
# Public URL where this API is deployed. It supplies OAuth callbacks if the
# provider-specific callback variables below are not set.
BACKEND_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notion_like_app
# Tune these to stay within your Postgres connection limit. The defaults (20/2)
# safely handle concurrent HTTP requests without opening a connection per request.
DB_MAX_CONNS=20
DB_MIN_CONNS=2
# Required outside local development: a 32+ character random secret.
SESSION_SECRET=replace-with-a-long-random-secret
# Set true when the app is served over HTTPS.
COOKIE_SECURE=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the callback configured in your GitHub OAuth App.
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
